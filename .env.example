# Gemini API Key (Required for AI NPC)
GEMINI_API_KEY=your_gemini_api_key_here

# Specified Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model parameters
GEMINI_TEMPERATURE=0.7
GEMINI_THINKING_BUDGET=0
GEMINI_API_TIMEOUT_SECONDS=10
GEMINI_MAX_OUTPUT_TOKENS=300

# NPC AI background worker configurations
NPC_AI_ENABLED=true
NPC_AI_POLL_INTERVAL_SECONDS=1
NPC_AI_STALE_TASK_SECONDS=60
NPC_AI_HISTORY_LIMIT=10
